{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotwire",
  "version": "0.1.0",
  "identifier": "dev.brede.hotwire",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hotwire",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": ["icons/icon.png"]
  }
}
